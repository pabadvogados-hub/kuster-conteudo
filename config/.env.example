# =============================================================================
#  config/.env  -  copie este arquivo para config/.env e preencha.
#  NUNCA suba o config/.env para o GitHub (o .gitignore ja bloqueia).
# =============================================================================

# ---------- IA (unica coisa obrigatoria) ----------
# Chave propria do escritorio: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# ---------- Modelos (nao precisa mexer) ----------
MODELO_ROTEIROS=claude-sonnet-5
MODELO_CARROSSEL=claude-sonnet-5
MODELO_ARTIGOS=claude-opus-5
MODELO_TRIAGEM=claude-haiku-5-5

# ---------- Estudio de video (opcional) ----------
# Caminho do Chrome, se quiser renderizar com o Chrome ja instalado (fica mais rapido).
# Em branco: o Remotion baixa o proprio navegador na primeira renderizacao.
CHROME_PATH=
